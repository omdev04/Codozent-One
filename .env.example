# ==============================================================================
# FACTORYFLOW ERP - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your secrets.
# ==============================================================================

# Server Network Configuration (Unified Frontend + Backend Port)
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# JWT & Security Configuration
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRES_IN=7d

# Global platform Super Admin (server only; never add VITE_ prefix)
PLATFORM_JWT_SECRET=replace_with_a_separate_random_secret_at_least_32_chars
PLATFORM_BOOTSTRAP_TOKEN=replace_with_a_one_time_random_secret_at_least_32_chars

# Supabase PostgreSQL Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth Integration (Supabase Auth Provider)
# Set in Google Cloud Console -> APIs & Services -> Credentials -> Authorized Redirect URIs:
SUPABASE_AUTH_GOOGLE_CALLBACK_URL=https://your-project.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Environment Variables (Vite accessible)
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Frontend Google OAuth & Auth Redirect Callback URL
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_AUTH_CALLBACK_URL=http://localhost:5000
